{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {"@mujtababhatti2/react-native-full-calendar": ["./src/index"]},
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": ["mujtababhatti2-react-native-full-calendar-source", "react-native-strict-api"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true,
    "types": ["jest"]
  }
}
